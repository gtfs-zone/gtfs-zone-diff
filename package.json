{
  "name": "gtfs-zone-diff",
  "version": "0.4.0",
  "description": "Compare two GTFS feeds in the browser",
  "main": "src/index.html",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run knip",
    "lint": "eslint src/ vite.config.js --max-warnings 0",
    "lint:fix": "eslint src/ vite.config.js --fix",
    "format": "prettier --write src/ vite.config.js",
    "knip": "knip",
    "vuln": "sh scripts/vuln-gate.sh",
    "commit": "cz commit"
  },
  "keywords": [
    "gtfs",
    "transit",
    "diff",
    "map"
  ],
  "author": "gtfs.zone contributors",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "autoprefixer": "^10.7.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "gtfs-realtime-bindings": "^1.1.1",
    "knip": "^6.47.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.8"
  },
  "dependencies": {
    "@leeoniya/ufuzzy": "^1.0.19",
    "@maplibre/geojson-vt": "^6.3.3",
    "@maplibre/vt-pbf": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.5",
    "daisyui": "^5.8.2",
    "diff": "^9.0.0",
    "fflate": "^0.8.3",
    "gtfs-zone-vocab": "github:gtfs-zone/gtfs-zone-vocab#v0.2.0",
    "gtfs-zone-web-common": "github:gtfs-zone/gtfs-zone-web-common#v7.20.0",
    "maplibre-gl": "^6.19.0",
    "papaparse": "^5.7.1",
    "zod": "^4.6.7"
  }
}
